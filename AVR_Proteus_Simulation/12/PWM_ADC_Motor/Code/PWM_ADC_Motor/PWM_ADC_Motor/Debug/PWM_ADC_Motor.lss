 11e:	80 83       	st	Z, r24
	// setting ADPS[0:2] = 111 to set prescaler factor to 128
	// frequency of ADC = F_CPU / prescaler factor = 16MHz / 128 = 1/8 MHz = 125 KHz
	ADCSRA |= (1<<ADEN);	// setting ADEN bit to 1 to turn on ADC
