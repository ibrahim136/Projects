 19e:	f0 e0       	ldi	r31, 0x00	; 0
 1a0:	90 81       	ld	r25, Z
 1a2:	92 60       	ori	r25, 0x02	; 2
 1a4:	90 83       	st	Z, r25
	uint16_t N = 1024;	// N = prescaler factor
	
	//Freq = F_CPU / (2 * N * ( 1 + OCRnx) )
	//OCRnx = ( F_CPU  / ( 2 * N * Freq ) ) - 1
	//OCRnx = ( (Time_in_ms * F_CPU)  / ( 1000 * N ) ) - 1
	OCR0A = ( (Time_Val * F_CPU)  / ( 1000 * N ) ) - 1;
